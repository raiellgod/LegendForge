  @@index([isActive])
}

model GameSession {
  id          String    @id @default(uuid())
  campaignId  String
  title       String
  scheduledAt DateTime?
  isFinished  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  campaign         Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  characterSheet   CharacterSheet? @relation(fields: [characterSheetId], references: [id])
  characterSheetId String?

  @@index([campaignId])
  @@index([scheduledAt])
}

model Participant {
  id         String            @id @default(uuid())
  campaignId String
  userId     String
  role       ParticipantRole   @default(PLAYER)
  status     ParticipantStatus @default(APPROVED)
  joinedAt   DateTime          @default(now())
  removedAt  DateTime?
  createdAt  DateTime          @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([campaignId])
  @@index([userId])
  @@index([status])
}

model CampaignActor {
  id          String                @id @default(uuid())
  campaignId  String
  ownerId     String?
  type        CampaignActorType
  location    CampaignActorLocation @default(TABLE)
  name        String
  initials    String
  description String?
  portraitUrl String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  campaign       Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  owner          User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  sceneTokens    SceneToken[]
  characterSheet CharacterSheet?
  npcSheet       NpcSheet?
  creatureSheet  CreatureSheet?

  @@index([campaignId])
  @@index([ownerId])
  @@index([type])
  @@index([location])
}

model SceneToken {
  id         String             @id @default(uuid())
  campaignId String
  actorId    String
  name       String
  initials   String
  type       CampaignActorType
  imageUrl   String?
  imageFit   SceneTokenImageFit @default(COVER)
  x          Int
  y          Int
  width      Int                @default(80)
  height     Int                @default(80)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  campaign Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  actor    CampaignActor @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([actorId])
}

model CampaignInvite {
  id              String       @id @default(uuid())
  campaignId      String
  senderId        String
  recipientUserId String?
  email           String?
  token           String       @unique
  status          InviteStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime     @default(now())

  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sender        User     @relation("CampaignInviteSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientUser User?    @relation("CampaignInviteRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([senderId])
  @@index([recipientUserId])
  @@index([token])
  @@index([status])
}

model CampaignLog {
  id         String   @id @default(uuid())
  campaignId String
  userId     String?
  type       LogType  @default(SYSTEM)
  content    String
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}
