generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  BANNED
  INACTIVE
}

enum ParticipantRole {
  PLAYER
  GM
}

enum ParticipantStatus {
  PENDING
  APPROVED
  REJECTED
  REMOVED
  LEAVE_REQUESTED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum LogType {
  CHAT
  SYSTEM
  ROLL
  COMBAT
}

enum SourceOrigin {
  OFFICIAL
  USER
  AI
}

enum CampaignActorType {
  PLAYER_CHARACTER
  NPC
  CREATURE
}

enum SceneTokenImageFit {
  COVER
  CONTAIN
  FILL
}

enum CreatureSize {
  TINY
  SMALL
  MEDIUM
  LARGE
  HUGE
  GARGANTUAN
}

enum FeatureSourceType {
  SYSTEM
  ANCESTRY
  CLASS
  SUBCLASS
  BACKGROUND
}

enum CharacterSheetStatus {
  DRAFT
  READY
  ARCHIVED
}

enum SpellSchool {
  ABJURATION
  CONJURATION
  DIVINATION
  ENCHANTMENT
  EVOCATION
  ILLUSION
  NECROMANCY
  TRANSMUTATION
}

enum EquipmentCategory {
  WEAPON
  ARMOR
  SHIELD
  TOOL
  GEAR
  CONSUMABLE
  RELIC
}

enum EquipmentAttackType {
  NONE
  MELEE
  RANGED
  THROWN
}

enum EquipmentWeaponGroup {
  SIMPLE
  MARTIAL
  IMPROVISED
  NATURAL
  TECH
  RELIC
}

enum CampaignActorLocation {
  TABLE
  LIBRARY
  ARCHIVED
}

model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  sessions       Session[]
  accounts       Account[]
  campaignsOwned Campaign[]
  participants   Participant[]

  sentCampaignInvites     CampaignInvite[] @relation("CampaignInviteSender")
  receivedCampaignInvites CampaignInvite[] @relation("CampaignInviteRecipient")

  campaignLogs   CampaignLog[]
  campaignActors CampaignActor[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model GameSystem {
  id        String   @id @default(uuid())
  name      String
  slug      String?  @unique
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  stats             Stat[]
  skills            Skill[]
  ancestries        Ancestry[]
  backgrounds       Background[]
  classes           CharacterClass[]
  subclasses        CharacterSubclass[]
  features          Feature[]
  spells            Spell[]
  equipment         Equipment[]
  languages         Language[]
  characterSheets   CharacterSheet[]
  levelProgressions LevelProgression[]
  campaigns         Campaign[]
}

model Ancestry {
  id                  String       @id @default(uuid())
  systemId            String
  name                String
  key                 String
  description         String?
  defaultSizeCategory CreatureSize @default(MEDIUM)
  attributeBonuses    Json         @default("{}")
  languageKeys        String[]     @default([])
  order               Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  system          GameSystem       @relation(fields: [systemId], references: [id], onDelete: Cascade)
  features        Feature[]
  characterSheets CharacterSheet[]

  @@unique([systemId, name])
  @@unique([systemId, key])
  @@index([systemId])
  @@index([order])
}

model Background {
  id                  String   @id @default(uuid())
  systemId            String
  name                String
  key                 String
  description         String?
  skillKeys           String[] @default([])
  toolNames           String[] @default([])
  languageChoiceCount Int      @default(0)
  languageKeys        String[] @default([])
  startingGold        Int      @default(0)
  attributeBonuses    Json     @default("{}")
  order               Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  system          GameSystem       @relation(fields: [systemId], references: [id], onDelete: Cascade)
  features        Feature[]
  characterSheets CharacterSheet[]

  @@unique([systemId, name])
  @@unique([systemId, key])
  @@index([systemId])
  @@index([order])
}

model CharacterSheet {
  id              String               @id @default(uuid())
  campaignId      String
  systemId        String
  campaignActorId String?              @unique
  ownerId         String?
  ancestryId      String?
  backgroundId    String?
  classId         String?
  subclassId      String?
  status          CharacterSheetStatus @default(DRAFT)

  name          String
  pronouns      String?
  concept       String?
  portraitUrl   String?
  tokenImageUrl String?
  tokenImageFit String  @default("COVER")

  level                   Int     @default(1)
  experience              Int     @default(0)
  levelUpAvailable        Boolean @default(false)
  hitPoints               Int     @default(0)
  maxHitPoints            Int     @default(0)
  temporaryHp             Int     @default(0)
  hitDiceUsed             Int     @default(0)
  deathSaveSuccesses      Int     @default(0)
  deathSaveFailures       Int     @default(0)
  armorClass              Int     @default(10)
  speed                   Int     @default(30)
  inspiration             Boolean @default(false)
  classEquipmentMode      String  @default("PACKAGE")
  backgroundEquipmentMode String  @default("PACKAGE")
  startingGold            Int     @default(0)

  alignment String?
  faith     String?
  lifestyle String?

  hair   String?
  skin   String?
  eyes   String?
  height String?
  weight String?
  age    String?
  gender String?

  bonds         String?
  flaws         String?
  ideals        String?
  personality   String?
  backstory     String?
  organizations String?
  allies        String?
  enemies       String?
  notes         String?
  otherNotes    String?
  gmNotes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign       Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  system         GameSystem         @relation(fields: [systemId], references: [id], onDelete: Cascade)
  campaignActor  CampaignActor?     @relation(fields: [campaignActorId], references: [id], onDelete: SetNull)
  ancestry       Ancestry?          @relation(fields: [ancestryId], references: [id], onDelete: SetNull)
  background     Background?        @relation(fields: [backgroundId], references: [id], onDelete: SetNull)
  characterClass CharacterClass?    @relation(fields: [classId], references: [id], onDelete: SetNull)
  subclass       CharacterSubclass? @relation(fields: [subclassId], references: [id], onDelete: SetNull)
  gameSessions   GameSession[]

  stats     CharacterSheetStat[]
  skills    CharacterSheetSkill[]
  spells    CharacterSheetSpell[]
  equipment CharacterSheetEquipment[]
  classes   CharacterSheetClass[]
  languages CharacterSheetLanguage[]

  @@index([campaignId])
  @@index([systemId])
  @@index([campaignActorId])
  @@index([ownerId])
  @@index([ancestryId])
  @@index([backgroundId])
  @@index([classId])
  @@index([subclassId])
  @@index([status])
}

model Language {
  id          String   @id @default(uuid())
  systemId    String
  name        String
  key         String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  system          GameSystem               @relation(fields: [systemId], references: [id], onDelete: Cascade)
  characterSheets CharacterSheetLanguage[]

  @@unique([systemId, name])
  @@unique([systemId, key])
  @@index([systemId])
  @@index([order])
}

model CharacterSheetLanguage {
  id               String   @id @default(uuid())
  characterSheetId String
  languageId       String
  source           String?  @default("builder")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  characterSheet CharacterSheet @relation(fields: [characterSheetId], references: [id], onDelete: Cascade)
  language       Language       @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([characterSheetId, languageId])
  @@index([characterSheetId])
  @@index([languageId])
  @@index([source])
}

model CharacterSheetStat {
  id                      String   @id @default(uuid())
  characterSheetId        String
  statId                  String
  baseValue               Int      @default(10)
  bonusValue              Int      @default(0)
  overrideValue           Int?
  isSavingThrowProficient Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  characterSheet CharacterSheet @relation(fields: [characterSheetId], references: [id], onDelete: Cascade)
  stat           Stat           @relation(fields: [statId], references: [id], onDelete: Cascade)

  @@unique([characterSheetId, statId])
  @@index([characterSheetId])
  @@index([statId])
}

model CharacterSheetSkill {
  id               String   @id @default(uuid())
  characterSheetId String
  skillId          String
  isProficient     Boolean  @default(false)
  expertiseLevel   Int      @default(0)
  bonusValue       Int      @default(0)
  overrideValue    Int?
  source           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  characterSheet CharacterSheet @relation(fields: [characterSheetId], references: [id], onDelete: Cascade)
  skill          Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([characterSheetId, skillId])
  @@index([characterSheetId])
  @@index([skillId])
  @@index([isProficient])
}

model CharacterSheetSpell {
  id               String   @id @default(uuid())
  characterSheetId String
  spellId          String
  source           String?
  isPrepared       Boolean  @default(false)
  isAlwaysPrepared Boolean  @default(false)
  uses             Int?
  maxUses          Int?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  characterSheet CharacterSheet @relation(fields: [characterSheetId], references: [id], onDelete: Cascade)
  spell          Spell          @relation(fields: [spellId], references: [id], onDelete: Cascade)

  @@unique([characterSheetId, spellId])
  @@index([characterSheetId])
  @@index([spellId])
  @@index([isPrepared])
}

model CharacterSheetEquipment {
  id               String   @id @default(uuid())
  characterSheetId String
  equipmentId      String
  quantity         Int      @default(1)
  isEquipped       Boolean  @default(false)
  isAttuned        Boolean  @default(false)
  source           String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  characterSheet CharacterSheet @relation(fields: [characterSheetId], references: [id], onDelete: Cascade)
  equipment      Equipment      @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@unique([characterSheetId, equipmentId])
  @@index([characterSheetId])
  @@index([equipmentId])
  @@index([isEquipped])
}

model CharacterSheetClass {
  id               String   @id @default(uuid())
  characterSheetId String
  classId          String
  subclassId       String?
  level            Int      @default(1)
  isPrimary        Boolean  @default(false)
  order            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  characterSheet CharacterSheet     @relation(fields: [characterSheetId], references: [id], onDelete: Cascade)
  characterClass CharacterClass     @relation(fields: [classId], references: [id], onDelete: Cascade)
  subclass       CharacterSubclass? @relation(fields: [subclassId], references: [id], onDelete: SetNull)

  @@unique([characterSheetId, classId])
  @@index([characterSheetId])
  @@index([classId])
  @@index([subclassId])
  @@index([isPrimary])
  @@index([order])
}

model CharacterClass {
  id                        String   @id @default(uuid())
  systemId                  String
  name                      String
  key                       String
  description               String?
  primaryRole               String?
  hitDie                    Int?
  spellcastingAbilityKey    String?
  subclassSelectionLevel    Int?
  classSkillChoiceCount     Int      @default(0)
  weaponProficiencyKeys     String[] @default([])
  protectionProficiencyKeys String[] @default([])
  toolProficiencyKeys       String[] @default([])
  order                     Int      @default(0)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @default(now()) @updatedAt

  system                GameSystem            @relation(fields: [systemId], references: [id], onDelete: Cascade)
  subclasses            CharacterSubclass[]
  levelProgressions     LevelProgression[]
  classSpells           ClassSpell[]
  features              Feature[]
  characterSheets       CharacterSheet[]
  characterSheetClasses CharacterSheetClass[]

  @@unique([systemId, name])
  @@unique([systemId, key])
  @@index([systemId])
  @@index([order])
}

model CharacterSubclass {
  id          String   @id @default(uuid())
  systemId    String
  classId     String
  name        String
  key         String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  system                GameSystem            @relation(fields: [systemId], references: [id], onDelete: Cascade)
  characterClass        CharacterClass        @relation(fields: [classId], references: [id], onDelete: Cascade)
  features              Feature[]
  characterSheets       CharacterSheet[]
  characterSheetClasses CharacterSheetClass[]

  @@unique([classId, name])
  @@unique([classId, key])
  @@index([systemId])
  @@index([classId])
  @@index([order])
}

model LevelProgression {
  id               String @id @default(uuid())
  systemId         String
  classId          String
  level            Int
  proficiencyBonus Int?

  cantripsKnown  Int @default(0)
  spellsKnown    Int @default(0)
  spellsPrepared Int @default(0)

  spellSlotsLevel1 Int @default(0)
  spellSlotsLevel2 Int @default(0)
  spellSlotsLevel3 Int @default(0)
  spellSlotsLevel4 Int @default(0)
  spellSlotsLevel5 Int @default(0)
  spellSlotsLevel6 Int @default(0)
  spellSlotsLevel7 Int @default(0)
  spellSlotsLevel8 Int @default(0)
  spellSlotsLevel9 Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  system         GameSystem     @relation(fields: [systemId], references: [id], onDelete: Cascade)
  characterClass CharacterClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  features       Feature[]

  @@unique([classId, level])
  @@index([systemId])
  @@index([classId])
  @@index([level])
}

model ClassSpell {
  id                String   @id @default(uuid())
  classId           String
  spellId           String
  minimumClassLevel Int      @default(1)
  isAlwaysKnown     Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  characterClass CharacterClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  spell          Spell          @relation(fields: [spellId], references: [id], onDelete: Cascade)

  @@unique([classId, spellId])
  @@index([classId])
  @@index([spellId])
  @@index([minimumClassLevel])
}

model Feature {
  id                 String            @id @default(uuid())
  systemId           String
  ancestryId         String?
  backgroundId       String?
  classId            String?
  subclassId         String?
  levelProgressionId String?
  sourceType         FeatureSourceType
  name               String
  key                String
  description        String?
  level              Int?
  order              Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  system           GameSystem         @relation(fields: [systemId], references: [id], onDelete: Cascade)
  ancestry         Ancestry?          @relation(fields: [ancestryId], references: [id], onDelete: Cascade)
  background       Background?        @relation(fields: [backgroundId], references: [id], onDelete: Cascade)
  characterClass   CharacterClass?    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subclass         CharacterSubclass? @relation(fields: [subclassId], references: [id], onDelete: Cascade)
  levelProgression LevelProgression?  @relation(fields: [levelProgressionId], references: [id], onDelete: SetNull)

  @@unique([systemId, key])
  @@index([systemId])
  @@index([ancestryId])
  @@index([backgroundId])
  @@index([classId])
  @@index([subclassId])
  @@index([levelProgressionId])
  @@index([sourceType])
  @@index([level])
  @@index([order])
}

model Spell {
  id                    String      @id @default(uuid())
  systemId              String
  name                  String
  key                   String
  description           String?
  level                 Int
  school                SpellSchool
  castingTime           String?
  range                 String?
  duration              String?
  components            String?
  isRitual              Boolean     @default(false)
  requiresConcentration Boolean     @default(false)
  order                 Int         @default(0)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  system          GameSystem            @relation(fields: [systemId], references: [id], onDelete: Cascade)
  characterSpells CharacterSheetSpell[]
  classSpells     ClassSpell[]

  @@unique([systemId, name])
  @@unique([systemId, key])
  @@index([systemId])
  @@index([level])
  @@index([school])
  @@index([order])
}

model Equipment {
  id          String            @id @default(uuid())
  systemId    String
  name        String
  key         String
  category    EquipmentCategory
  description String?
  imageUrl    String?
  cost        String?
  weight      Float?

  damage                 String?
  damageFormula          String?
  damageType             String?
  defense                Int?
  properties             String?
  attackType             EquipmentAttackType   @default(NONE)
  attackAbilityKey       String?
  alternativeAbilityKey  String?
  weaponGroup            EquipmentWeaponGroup?
  normalRange            Int?
  longRange              Int?
  isFinesse              Boolean               @default(false)
  isThrown               Boolean               @default(false)
  isTwoHanded            Boolean               @default(false)
  isVersatile            Boolean               @default(false)
  versatileDamageFormula String?
  attackBonus            Int                   @default(0)
  damageBonus            Int                   @default(0)

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  system             GameSystem                @relation(fields: [systemId], references: [id], onDelete: Cascade)
  characterEquipment CharacterSheetEquipment[]

  @@unique([systemId, name])
  @@unique([systemId, key])
  @@index([systemId])
  @@index([category])
  @@index([attackType])
  @@index([weaponGroup])
  @@index([order])
}

model Stat {
  id          String   @id @default(uuid())
  systemId    String
  name        String
  key         String   @default("")
  shortName   String   @default("")
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  system         GameSystem           @relation(fields: [systemId], references: [id], onDelete: Cascade)
  skills         Skill[]
  characterStats CharacterSheetStat[]

  @@unique([systemId, name])
  @@unique([systemId, key])
  @@index([systemId])
  @@index([order])
}

model Skill {
  id          String   @id @default(uuid())
  systemId    String
  statId      String
  name        String
  key         String   @default("")
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  system          GameSystem            @relation(fields: [systemId], references: [id], onDelete: Cascade)
  stat            Stat                  @relation(fields: [statId], references: [id], onDelete: Cascade)
  characterSkills CharacterSheetSkill[]

  @@unique([systemId, name])
  @@unique([systemId, key])
  @@index([systemId])
  @@index([statId])
  @@index([order])
}

model Campaign {
  id          String   @id @default(uuid())
  name        String
  description String?
  coverImage  String?
  ownerId     String
  systemId    String?
  isPublic    Boolean  @default(false)
  isActive    Boolean  @default(true)
  maxPlayers  Int      @default(5)
  inviteCode  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner  User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  system GameSystem? @relation(fields: [systemId], references: [id], onDelete: SetNull)

  participants    Participant[]
  sessions        GameSession[]
  invites         CampaignInvite[]
  logs            CampaignLog[]
  actors          CampaignActor[]
  characterSheets CharacterSheet[]
  sceneTokens     SceneToken[]

  @@index([ownerId])
  @@index([systemId])
  @@index([isPublic])
  @@index([isActive])
}

model GameSession {
  id          String    @id @default(uuid())
  campaignId  String
  title       String
  scheduledAt DateTime?
  isFinished  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  campaign         Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  characterSheet   CharacterSheet? @relation(fields: [characterSheetId], references: [id])
  characterSheetId String?

  @@index([campaignId])
  @@index([scheduledAt])
}

model Participant {
  id         String            @id @default(uuid())
  campaignId String
  userId     String
  role       ParticipantRole   @default(PLAYER)
  status     ParticipantStatus @default(APPROVED)
  joinedAt   DateTime          @default(now())
  removedAt  DateTime?
  createdAt  DateTime          @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([campaignId])
  @@index([userId])
  @@index([status])
}

model CampaignActor {
  id          String                @id @default(uuid())
  campaignId  String
  ownerId     String?
  type        CampaignActorType
  location    CampaignActorLocation @default(TABLE)
  name        String
  initials    String
  description String?
  portraitUrl String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  campaign       Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  owner          User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  sceneTokens    SceneToken[]
  characterSheet CharacterSheet?

  @@index([campaignId])
  @@index([ownerId])
  @@index([type])
  @@index([location])
}

model SceneToken {
  id         String             @id @default(uuid())
  campaignId String
  actorId    String
  name       String
  initials   String
  type       CampaignActorType
  imageUrl   String?
  imageFit   SceneTokenImageFit @default(COVER)
  x          Int
  y          Int
  width      Int                @default(80)
  height     Int                @default(80)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  campaign Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  actor    CampaignActor @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([actorId])
}

model CampaignInvite {
  id              String       @id @default(uuid())
  campaignId      String
  senderId        String
  recipientUserId String?
  email           String?
  token           String       @unique
  status          InviteStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime     @default(now())

  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sender        User     @relation("CampaignInviteSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientUser User?    @relation("CampaignInviteRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([senderId])
  @@index([recipientUserId])
  @@index([token])
  @@index([status])
}

model CampaignLog {
  id         String   @id @default(uuid())
  campaignId String
  userId     String?
  type       LogType  @default(SYSTEM)
  content    String
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}
