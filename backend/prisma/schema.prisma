generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  BANNED
  INACTIVE
}

enum ParticipantRole {
  PLAYER
  GM
}

enum ParticipantStatus {
  PENDING
  APPROVED
  REJECTED
  REMOVED
  LEAVE_REQUESTED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum LogType {
  CHAT
  SYSTEM
  ROLL
  COMBAT
}

enum SourceOrigin {
  OFFICIAL
  USER
  AI
}

enum CampaignActorType {
  PLAYER_CHARACTER
  NPC
  CREATURE
}

enum SceneTokenImageFit {
  COVER
  CONTAIN
  FILL
}

enum CreatureSize {
  TINY
  SMALL
  MEDIUM
  LARGE
  HUGE
  GARGANTUAN
}

enum CampaignActorLocation {
  TABLE
  LIBRARY
  ARCHIVED
}

model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  sessions       Session[]
  accounts       Account[]
  campaignsOwned Campaign[]
  participants   Participant[]

  sentCampaignInvites     CampaignInvite[] @relation("CampaignInviteSender")
  receivedCampaignInvites CampaignInvite[] @relation("CampaignInviteRecipient")

  campaignLogs   CampaignLog[]
  campaignActors CampaignActor[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model GameSystem {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String?  @unique
  version   Int
  createdAt DateTime @default(now())

  stats      Stat[]
  skills     Skill[]
  ancestries Ancestry[]
  classes    CharacterClass[]
  subclasses CharacterSubclass[]
  campaigns  Campaign[]
}

model Ancestry {
  id                  String       @id @default(uuid())
  systemId            String
  name                String
  key                 String
  description         String?
  defaultSizeCategory CreatureSize @default(MEDIUM)
  order               Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  system GameSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@unique([systemId, name])
  @@unique([systemId, key])
  @@index([systemId])
  @@index([order])
}

model CharacterClass {
  id          String   @id @default(uuid())
  systemId    String
  name        String
  key         String
  description String?
  primaryRole String?
  hitDie      Int?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  system     GameSystem          @relation(fields: [systemId], references: [id], onDelete: Cascade)
  subclasses CharacterSubclass[]

  @@unique([systemId, name])
  @@unique([systemId, key])
  @@index([systemId])
  @@index([order])
}

model CharacterSubclass {
  id          String   @id @default(uuid())
  systemId    String
  classId     String
  name        String
  key         String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  system         GameSystem     @relation(fields: [systemId], references: [id], onDelete: Cascade)
  characterClass CharacterClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, name])
  @@unique([classId, key])
  @@index([systemId])
  @@index([classId])
  @@index([order])
}

model Stat {
  id          String   @id @default(uuid())
  systemId    String
  name        String
  key         String   @default("")
  shortName   String   @default("")
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  system GameSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)
  skills Skill[]

  @@unique([systemId, name])
  @@unique([systemId, key])
  @@index([systemId])
  @@index([order])
}

model Skill {
  id          String   @id @default(uuid())
  systemId    String
  statId      String
  name        String
  key         String   @default("")
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  system GameSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)
  stat   Stat       @relation(fields: [statId], references: [id], onDelete: Cascade)

  @@unique([systemId, name])
  @@unique([systemId, key])
  @@index([systemId])
  @@index([statId])
  @@index([order])
}

model Campaign {
  id          String   @id @default(uuid())
  name        String
  description String?
  coverImage  String?
  ownerId     String
  systemId    String?
  isPublic    Boolean  @default(false)
  isActive    Boolean  @default(true)
  maxPlayers  Int      @default(5)
  inviteCode  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner  User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  system GameSystem? @relation(fields: [systemId], references: [id], onDelete: SetNull)

  participants Participant[]
  sessions     GameSession[]
  invites      CampaignInvite[]
  logs         CampaignLog[]
  actors       CampaignActor[]
  sceneTokens  SceneToken[]

  @@index([ownerId])
  @@index([systemId])
  @@index([isPublic])
  @@index([isActive])
}

model GameSession {
  id          String    @id @default(uuid())
  campaignId  String
  title       String
  scheduledAt DateTime?
  isFinished  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([scheduledAt])
}

model Participant {
  id         String            @id @default(uuid())
  campaignId String
  userId     String
  role       ParticipantRole   @default(PLAYER)
  status     ParticipantStatus @default(APPROVED)
  joinedAt   DateTime          @default(now())
  removedAt  DateTime?
  createdAt  DateTime          @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([campaignId])
  @@index([userId])
  @@index([status])
}

model CampaignActor {
  id          String                @id @default(uuid())
  campaignId  String
  ownerId     String?
  type        CampaignActorType
  location    CampaignActorLocation @default(TABLE)
  name        String
  initials    String
  description String?
  portraitUrl String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  owner       User?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  sceneTokens SceneToken[]

  @@index([campaignId])
  @@index([ownerId])
  @@index([type])
  @@index([location])
}

model SceneToken {
  id         String             @id @default(uuid())
  campaignId String
  actorId    String
  name       String
  initials   String
  type       CampaignActorType
  imageUrl   String?
  imageFit   SceneTokenImageFit @default(COVER)
  x          Int
  y          Int
  width      Int                @default(80)
  height     Int                @default(80)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  campaign Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  actor    CampaignActor @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([actorId])
}

model CampaignInvite {
  id              String       @id @default(uuid())
  campaignId      String
  senderId        String
  recipientUserId String?
  email           String?
  token           String       @unique
  status          InviteStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime     @default(now())

  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sender        User     @relation("CampaignInviteSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientUser User?    @relation("CampaignInviteRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([senderId])
  @@index([recipientUserId])
  @@index([token])
  @@index([status])
}

model CampaignLog {
  id         String   @id @default(uuid())
  campaignId String
  userId     String?
  type       LogType  @default(SYSTEM)
  content    String
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}
