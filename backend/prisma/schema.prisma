generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  BANNED
  INACTIVE
}

enum ParticipantRole {
  PLAYER
  GM
}

enum ParticipantStatus {
  PENDING
  APPROVED
  REJECTED
  REMOVED
  LEAVE_REQUESTED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum LogType {
  CHAT
  SYSTEM
  ROLL
  COMBAT
}

enum SourceOrigin {
  OFFICIAL
  USER
  AI
}

enum CampaignActorType {
  PLAYER_CHARACTER
  NPC
  CREATURE
}

enum SceneTokenImageFit {
  COVER
  CONTAIN
  FILL
}

enum CreatureSize {
  TINY
  SMALL
  MEDIUM
  LARGE
  HUGE
  GARGANTUAN
}

enum FeatureSourceType {
  ANCESTRY
  SUBANCESTRY
  BACKGROUND
  CLASS
  SUBCLASS
  LEVEL
  CHOICE
}

enum CharacterSheetStatus {
  DRAFT
  READY
  ARCHIVED
}

enum CharacterProgressionChoiceType {
  ATTRIBUTE_INCREASE
  TALENT
}

enum CharacterAttributeIncreaseMode {
  FOCUSED
  SPLIT
}

enum SpellSchool {
  ABJURATION
  CONJURATION
  DIVINATION
  ENCHANTMENT
  EVOCATION
  ILLUSION
  NECROMANCY
  TRANSMUTATION
}

enum EquipmentCategory {
  WEAPON
  ARMOR
  SHIELD
  TOOL
  GEAR
  CONSUMABLE
  RELIC
}

enum EquipmentAttackType {
  NONE
  MELEE
  RANGED
  THROWN
}

enum EquipmentWeaponGroup {
  SIMPLE
  MARTIAL
  IMPROVISED
  NATURAL
  TECH
  RELIC
}

enum CampaignActorLocation {
  TABLE
  LIBRARY
  ARCHIVED
}

enum SheetDefenseKind {
  RESISTANCE
  IMMUNITY
  VULNERABILITY
}

enum SheetActionKind {
  ACTION
  BONUS_ACTION
  REACTION
}

enum SheetAttackType {
  MELEE
  RANGED
  THROWN
  MAGIC
  OTHER
}

model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  sessions       Session[]
  accounts       Account[]
  campaignsOwned Campaign[]
  participants   Participant[]

  sentCampaignInvites     CampaignInvite[] @relation("CampaignInviteSender")
  receivedCampaignInvites CampaignInvite[] @relation("CampaignInviteRecipient")

  campaignLogs   CampaignLog[]
  campaignActors CampaignActor[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model GameSystem {
  id        String   @id @default(uuid())
  name      String
  slug      String?  @unique
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  stats               Stat[]
  skills              Skill[]
  ancestries          Ancestry[]
  subAncestries       SubAncestry[]
  backgrounds         Background[]
  classes             CharacterClass[]
  subclasses          CharacterSubclass[]
  features            Feature[]
  talents             Talent[]
  spells              Spell[]
  equipment           Equipment[]
  languages           Language[]
  characterSheets     CharacterSheet[]
  npcSheets           NpcSheet[]
  creatureSheets      CreatureSheet[]
  levelProgressions   LevelProgression[]
  featureChoiceGroups FeatureChoiceGroup[]
  npcTemplates        NpcTemplate[]
  creatureTemplates   CreatureTemplate[]
  characterTemplates  CharacterTemplate[]
  campaigns           Campaign[]
}

model NpcTemplate {
  id            String  @id @default(uuid())
  systemId      String
  key           String
  name          String
  initials      String?
  description   String?
  ancestryId    String?
  subAncestryId String?
  backgroundId  String?

  size CreatureSize @default(MEDIUM)
  role String?

  faction     String?
  personality String?
  motivation  String?
  behavior    String?
  tactics     String?
  lore        String?
  notes       String?

  portraitUrl   String?
  tokenImageUrl String?
  tokenImageFit SceneTokenImageFit @default(COVER)

  armorClass   Int @default(10)
  hitPoints    Int @default(1)
  maxHitPoints Int @default(1)
  temporaryHp  Int @default(0)

  speed       Int @default(30)
  climbSpeed  Int @default(0)
  swimSpeed   Int @default(0)
  flySpeed    Int @default(0)
  burrowSpeed Int @default(0)

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  system      GameSystem   @relation(fields: [systemId], references: [id], onDelete: Cascade)
  ancestry    Ancestry?    @relation(fields: [ancestryId], references: [id], onDelete: SetNull)
  subAncestry SubAncestry? @relation(fields: [subAncestryId], references: [id], onDelete: SetNull)
  background  Background?  @relation(fields: [backgroundId], references: [id], onDelete: SetNull)

  classes          NpcTemplateClass[]
  stats            NpcTemplateStat[]
  skills           NpcTemplateSkill[]
  defenses         NpcTemplateDefense[]
  senses           NpcTemplateSense[]
  languages        NpcTemplateLanguage[]
  traits           NpcTemplateTrait[]
  actions          NpcTemplateAction[]
  attacks          NpcTemplateAttack[]
  multiattacks     NpcTemplateMultiattack[]
  magicalAbilities NpcTemplateMagicalAbility[]

  @@unique([systemId, key])
  @@unique([systemId, name])
  @@index([systemId])
  @@index([ancestryId])
  @@index([subAncestryId])
  @@index([backgroundId])
  @@index([order])
}

model CreatureTemplate {
  id          String  @id @default(uuid())
  systemId    String
  key         String
  name        String
  initials    String?
  description String?

  size         CreatureSize @default(MEDIUM)
  creatureType String?

  habitat  String?
  behavior String?
  tactics  String?
  lore     String?
  notes    String?

  portraitUrl   String?
  tokenImageUrl String?
  tokenImageFit SceneTokenImageFit @default(COVER)

  armorClass   Int @default(10)
  hitPoints    Int @default(1)
  maxHitPoints Int @default(1)
  temporaryHp  Int @default(0)

  speed       Int @default(30)
  climbSpeed  Int @default(0)
  swimSpeed   Int @default(0)
  flySpeed    Int @default(0)
  burrowSpeed Int @default(0)

  challengeRating  String?
  experienceReward Int     @default(0)

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  system GameSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)

  stats            CreatureTemplateStat[]
  skills           CreatureTemplateSkill[]
  defenses         CreatureTemplateDefense[]
  senses           CreatureTemplateSense[]
  languages        CreatureTemplateLanguage[]
  traits           CreatureTemplateTrait[]
  actions          CreatureTemplateAction[]
  attacks          CreatureTemplateAttack[]
  multiattacks     CreatureTemplateMultiattack[]
  magicalAbilities CreatureTemplateMagicalAbility[]

  @@unique([systemId, key])
  @@unique([systemId, name])
  @@index([systemId])
  @@index([size])
  @@index([challengeRating])
  @@index([order])
}

model NpcTemplateClass {
  id            String  @id @default(uuid())
  npcTemplateId String
  classId       String
  subclassId    String?
  level         Int     @default(1)
  isPrimary     Boolean @default(false)
  order         Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  npcTemplate    NpcTemplate        @relation(fields: [npcTemplateId], references: [id], onDelete: Cascade)
  characterClass CharacterClass     @relation(fields: [classId], references: [id], onDelete: Cascade)
  subclass       CharacterSubclass? @relation(fields: [subclassId], references: [id], onDelete: SetNull)

  @@unique([npcTemplateId, classId])
  @@index([npcTemplateId])
  @@index([classId])
  @@index([subclassId])
  @@index([isPrimary])
  @@index([order])
}

model NpcTemplateStat {
  id                      String  @id @default(uuid())
  npcTemplateId           String
  statId                  String
  baseValue               Int     @default(10)
  bonusValue              Int     @default(0)
  overrideValue           Int?
  isSavingThrowProficient Boolean @default(false)
  savingThrowBonus        Int     @default(0)
  savingThrowOverride     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  npcTemplate NpcTemplate @relation(fields: [npcTemplateId], references: [id], onDelete: Cascade)
  stat        Stat        @relation(fields: [statId], references: [id], onDelete: Cascade)

  @@unique([npcTemplateId, statId])
  @@index([npcTemplateId])
  @@index([statId])
  @@index([isSavingThrowProficient])
}

model NpcTemplateSkill {
  id             String  @id @default(uuid())
  npcTemplateId  String
  skillId        String
  isProficient   Boolean @default(false)
  expertiseLevel Int     @default(0)
  bonusValue     Int     @default(0)
  overrideValue  Int?
  source         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  npcTemplate NpcTemplate @relation(fields: [npcTemplateId], references: [id], onDelete: Cascade)
  skill       Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([npcTemplateId, skillId])
  @@index([npcTemplateId])
  @@index([skillId])
  @@index([isProficient])
}

model NpcTemplateDefense {
  id            String           @id @default(uuid())
  npcTemplateId String
  kind          SheetDefenseKind
  damageType    String
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  npcTemplate NpcTemplate @relation(fields: [npcTemplateId], references: [id], onDelete: Cascade)

  @@unique([npcTemplateId, kind, damageType])
  @@index([npcTemplateId])
  @@index([kind])
  @@index([damageType])
}

model NpcTemplateSense {
  id            String  @id @default(uuid())
  npcTemplateId String
  name          String
  range         Int?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  npcTemplate NpcTemplate @relation(fields: [npcTemplateId], references: [id], onDelete: Cascade)

  @@unique([npcTemplateId, name])
  @@index([npcTemplateId])
  @@index([name])
}

model NpcTemplateLanguage {
  id            String  @id @default(uuid())
  npcTemplateId String
  languageId    String
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  npcTemplate NpcTemplate @relation(fields: [npcTemplateId], references: [id], onDelete: Cascade)
  language    Language    @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([npcTemplateId, languageId])
  @@index([npcTemplateId])
  @@index([languageId])
}

model NpcTemplateTrait {
  id            String @id @default(uuid())
  npcTemplateId String
  name          String
  description   String
  order         Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  npcTemplate NpcTemplate @relation(fields: [npcTemplateId], references: [id], onDelete: Cascade)

  @@unique([npcTemplateId, name])
  @@index([npcTemplateId])
  @@index([order])
}

model NpcTemplateAction {
  id            String          @id @default(uuid())
  npcTemplateId String
  kind          SheetActionKind @default(ACTION)
  name          String
  description   String
  uses          Int?
  maxUses       Int?
  recharge      String?
  order         Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  npcTemplate        NpcTemplate                   @relation(fields: [npcTemplateId], references: [id], onDelete: Cascade)
  multiattackEntries NpcTemplateMultiattackEntry[]

  @@unique([npcTemplateId, kind, name])
  @@index([npcTemplateId])
  @@index([kind])
  @@index([order])
}

model NpcTemplateAttack {
  id                     String          @id @default(uuid())
  npcTemplateId          String
  name                   String
  description            String?
  attackType             SheetAttackType @default(MELEE)
  attackAbilityKey       String?
  attackBonus            Int             @default(0)
  damageFormula          String?
  damageBonus            Int             @default(0)
  damageType             String?
  secondaryDamageFormula String?
  secondaryDamageType    String?
  normalRange            Int?
  longRange              Int?
  reach                  Int?
  target                 String?
  saveAbilityKey         String?
  saveDc                 Int?
  onHit                  String?
  notes                  String?
  order                  Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  npcTemplate        NpcTemplate                   @relation(fields: [npcTemplateId], references: [id], onDelete: Cascade)
  multiattackEntries NpcTemplateMultiattackEntry[]

  @@unique([npcTemplateId, name])
  @@index([npcTemplateId])
  @@index([attackType])
  @@index([attackAbilityKey])
  @@index([damageType])
  @@index([order])
}

model NpcTemplateMultiattack {
  id            String  @id @default(uuid())
  npcTemplateId String
  name          String  @default("Multiataque")
  description   String?
  order         Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  npcTemplate NpcTemplate                   @relation(fields: [npcTemplateId], references: [id], onDelete: Cascade)
  entries     NpcTemplateMultiattackEntry[]

  @@unique([npcTemplateId, name])
  @@index([npcTemplateId])
  @@index([order])
}

model NpcTemplateMultiattackEntry {
  id            String  @id @default(uuid())
  multiattackId String
  attackId      String?
  actionId      String?
  quantity      Int     @default(1)
  order         Int     @default(0)
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  multiattack NpcTemplateMultiattack @relation(fields: [multiattackId], references: [id], onDelete: Cascade)
  attack      NpcTemplateAttack?     @relation(fields: [attackId], references: [id], onDelete: Cascade)
  action      NpcTemplateAction?     @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([multiattackId])
  @@index([attackId])
  @@index([actionId])
  @@index([order])
}

model NpcTemplateMagicalAbility {
  id            String  @id @default(uuid())
  npcTemplateId String
  spellId       String?
  name          String
  description   String?
  abilityKey    String?
  attackBonus   Int?
  saveDc        Int?
  damageFormula String?
  damageBonus   Int     @default(0)
  damageType    String?
  range         String?
  target        String?
  uses          Int?
  maxUses       Int?
  recharge      String?
  isPassive     Boolean @default(false)
  notes         String?
  order         Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  npcTemplate NpcTemplate @relation(fields: [npcTemplateId], references: [id], onDelete: Cascade)
  spell       Spell?      @relation(fields: [spellId], references: [id], onDelete: SetNull)

  @@unique([npcTemplateId, name])
  @@index([npcTemplateId])
  @@index([spellId])
  @@index([abilityKey])
  @@index([order])
}

model CreatureTemplateStat {
  id                      String  @id @default(uuid())
  creatureTemplateId      String
  statId                  String
  baseValue               Int     @default(10)
  bonusValue              Int     @default(0)
  overrideValue           Int?
  isSavingThrowProficient Boolean @default(false)
  savingThrowBonus        Int     @default(0)
  savingThrowOverride     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creatureTemplate CreatureTemplate @relation(fields: [creatureTemplateId], references: [id], onDelete: Cascade)
  stat             Stat             @relation(fields: [statId], references: [id], onDelete: Cascade)

  @@unique([creatureTemplateId, statId])
  @@index([creatureTemplateId])
  @@index([statId])
  @@index([isSavingThrowProficient])
}

model CreatureTemplateSkill {
  id                 String  @id @default(uuid())
  creatureTemplateId String
  skillId            String
  isProficient       Boolean @default(false)
  expertiseLevel     Int     @default(0)
  bonusValue         Int     @default(0)
  overrideValue      Int?
  source             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creatureTemplate CreatureTemplate @relation(fields: [creatureTemplateId], references: [id], onDelete: Cascade)
  skill            Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([creatureTemplateId, skillId])
  @@index([creatureTemplateId])
  @@index([skillId])
  @@index([isProficient])
}

model CreatureTemplateDefense {
  id                 String           @id @default(uuid())
  creatureTemplateId String
  kind               SheetDefenseKind
  damageType         String
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creatureTemplate CreatureTemplate @relation(fields: [creatureTemplateId], references: [id], onDelete: Cascade)

  @@unique([creatureTemplateId, kind, damageType])
  @@index([creatureTemplateId])
  @@index([kind])
  @@index([damageType])
}

model CreatureTemplateSense {
  id                 String  @id @default(uuid())
  creatureTemplateId String
  name               String
  range              Int?
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creatureTemplate CreatureTemplate @relation(fields: [creatureTemplateId], references: [id], onDelete: Cascade)

  @@unique([creatureTemplateId, name])
  @@index([creatureTemplateId])
  @@index([name])
}

model CreatureTemplateLanguage {
  id                 String  @id @default(uuid())
  creatureTemplateId String
  languageId         String
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creatureTemplate CreatureTemplate @relation(fields: [creatureTemplateId], references: [id], onDelete: Cascade)
  language         Language         @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([creatureTemplateId, languageId])
  @@index([creatureTemplateId])
  @@index([languageId])
}

model CreatureTemplateTrait {
  id                 String @id @default(uuid())
  creatureTemplateId String
  name               String
  description        String
  order              Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creatureTemplate CreatureTemplate @relation(fields: [creatureTemplateId], references: [id], onDelete: Cascade)

  @@unique([creatureTemplateId, name])
  @@index([creatureTemplateId])
  @@index([order])
}

model CreatureTemplateAction {
  id                 String          @id @default(uuid())
  creatureTemplateId String
  kind               SheetActionKind @default(ACTION)
  name               String
  description        String
  uses               Int?
  maxUses            Int?
  recharge           String?
  order              Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creatureTemplate   CreatureTemplate                   @relation(fields: [creatureTemplateId], references: [id], onDelete: Cascade)
  multiattackEntries CreatureTemplateMultiattackEntry[]

  @@unique([creatureTemplateId, kind, name])
  @@index([creatureTemplateId])
  @@index([kind])
  @@index([order])
}

model CreatureTemplateAttack {
  id                     String          @id @default(uuid())
  creatureTemplateId     String
  name                   String
  description            String?
  attackType             SheetAttackType @default(MELEE)
  attackAbilityKey       String?
  attackBonus            Int             @default(0)
  damageFormula          String?
  damageBonus            Int             @default(0)
  damageType             String?
  secondaryDamageFormula String?
  secondaryDamageType    String?
  normalRange            Int?
  longRange              Int?
  reach                  Int?
  target                 String?
  saveAbilityKey         String?
  saveDc                 Int?
  onHit                  String?
  notes                  String?
  order                  Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creatureTemplate   CreatureTemplate                   @relation(fields: [creatureTemplateId], references: [id], onDelete: Cascade)
  multiattackEntries CreatureTemplateMultiattackEntry[]

  @@unique([creatureTemplateId, name])
  @@index([creatureTemplateId])
  @@index([attackType])
  @@index([attackAbilityKey])
  @@index([damageType])
  @@index([order])
}

model CreatureTemplateMultiattack {
  id                 String  @id @default(uuid())
  creatureTemplateId String
  name               String  @default("Multiataque")
  description        String?
  order              Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creatureTemplate CreatureTemplate                   @relation(fields: [creatureTemplateId], references: [id], onDelete: Cascade)
  entries          CreatureTemplateMultiattackEntry[]

  @@unique([creatureTemplateId, name])
  @@index([creatureTemplateId])
  @@index([order])
}

model CreatureTemplateMultiattackEntry {
  id            String  @id @default(uuid())
  multiattackId String
  attackId      String?
  actionId      String?
  quantity      Int     @default(1)
  order         Int     @default(0)
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  multiattack CreatureTemplateMultiattack @relation(fields: [multiattackId], references: [id], onDelete: Cascade)
  attack      CreatureTemplateAttack?     @relation(fields: [attackId], references: [id], onDelete: Cascade)
  action      CreatureTemplateAction?     @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([multiattackId])
  @@index([attackId])
  @@index([actionId])
  @@index([order])
}

model CreatureTemplateMagicalAbility {
  id                 String  @id @default(uuid())
  creatureTemplateId String
  spellId            String?
  name               String
  description        String?
  abilityKey         String?
  attackBonus        Int?
  saveDc             Int?
  damageFormula      String?
  damageBonus        Int     @default(0)
  damageType         String?
  range              String?
  target             String?
  uses               Int?
  maxUses            Int?
  recharge           String?
  isPassive          Boolean @default(false)
  notes              String?
  order              Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creatureTemplate CreatureTemplate @relation(fields: [creatureTemplateId], references: [id], onDelete: Cascade)
  spell            Spell?           @relation(fields: [spellId], references: [id], onDelete: SetNull)

  @@unique([creatureTemplateId, name])
  @@index([creatureTemplateId])
  @@index([spellId])
  @@index([abilityKey])
  @@index([order])
}

model Ancestry {
  id                  String       @id @default(uuid())
  systemId            String
  name                String
  key                 String
  description         String?
  defaultSizeCategory CreatureSize @default(MEDIUM)
  attributeBonuses    Json         @default("{}")
  languageKeys        String[]     @default([])
  order               Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  system              GameSystem           @relation(fields: [systemId], references: [id], onDelete: Cascade)
  subAncestries       SubAncestry[]
  features            Feature[]
  featureChoiceGroups FeatureChoiceGroup[]
  characterSheets     CharacterSheet[]
  characterTemplates  CharacterTemplate[]
  npcTemplates        NpcTemplate[]
  npcSheets           NpcSheet[]

  @@unique([systemId, name])
  @@unique([systemId, key])
  @@index([systemId])
  @@index([order])
}

model SubAncestry {
  id                   String        @id @default(uuid())
  systemId             String
  ancestryId           String
  name                 String
  key                  String
  description          String?
  sizeCategoryOverride CreatureSize?
  attributeBonuses     Json          @default("{}")
  languageKeys         String[]      @default([])
  order                Int           @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  system              GameSystem           @relation(fields: [systemId], references: [id], onDelete: Cascade)
  ancestry            Ancestry             @relation(fields: [ancestryId], references: [id], onDelete: Cascade)
  features            Feature[]
  featureChoiceGroups FeatureChoiceGroup[]
  characterSheets     CharacterSheet[]
  characterTemplates  CharacterTemplate[]
  npcTemplates        NpcTemplate[]
  npcSheets           NpcSheet[]

